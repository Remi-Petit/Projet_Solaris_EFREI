expression q_fait_agrege =
		let
		    Fait = q_fait_mutation,
		    Cols = Table.SelectColumns(Fait, {"cle_mutation", "cle_temps", "cle_commune", "cle_nature_mutation", "valeur_fonciere", "surface_reelle_bati", "nombre_pieces_principales"}),
		    Mutations = Table.Distinct(Cols, {"cle_mutation"}),
		    GroupeMut = Table.Group(Mutations, {"cle_temps", "cle_commune", "cle_nature_mutation"}, {{"nombre_de_mutations", each Table.RowCount(_), Int64.Type}, {"valeur_fonciere_totale", each List.Sum([valeur_fonciere]), type number}}),
		    GroupeLoc = Table.Group(Cols, {"cle_temps", "cle_commune", "cle_nature_mutation"}, {{"nombre_de_locaux", each Table.RowCount(_), Int64.Type}, {"surface_batie_totale", each List.Sum([surface_reelle_bati]), type number}, {"nombre_pieces_total", each List.Sum([nombre_pieces_principales]), Int64.Type}}),
		    Jointure = Table.NestedJoin(GroupeMut, {"cle_temps", "cle_commune", "cle_nature_mutation"}, GroupeLoc, {"cle_temps", "cle_commune", "cle_nature_mutation"}, "Loc", JoinKind.LeftOuter),
		    Etendu = Table.ExpandTableColumn(Jointure, "Loc", {"nombre_de_locaux", "surface_batie_totale", "nombre_pieces_total"}),
		    PrixM2 = Table.AddColumn(Etendu, "prix_moyen_m2", each if [surface_batie_totale] = null or [surface_batie_totale] = 0 then null else [valeur_fonciere_totale] / [surface_batie_totale], type number),
		    Final = Table.SelectColumns(PrixM2, {"cle_temps", "cle_commune", "cle_nature_mutation", "nombre_de_mutations", "nombre_de_locaux", "valeur_fonciere_totale", "surface_batie_totale", "nombre_pieces_total", "prix_moyen_m2"})
		in
		    Final
	lineageTag: d98904cd-0e61-4925-b16b-30e9ba157a3a

