expression q_dim_region =
		let
		    Base = q_dim_departement,
		    Regions = Table.Distinct(Table.SelectColumns(Base, {"cle_region"})),
		    Filtre = Table.SelectRows(Regions, each [cle_region] <> null and [cle_region] <> ""),
		    Jointure = Table.NestedJoin(Filtre, {"cle_region"}, q_ref_region, {"cle_region"}, "Ref", JoinKind.LeftOuter),
		    Etendu = Table.ExpandTableColumn(Jointure, "Ref", {"nom_region"}),
		    Colonnes = Table.SelectColumns(Etendu, {"cle_region", "nom_region"}),
		    Trie = Table.Sort(Colonnes, {{"nom_region", Order.Ascending}})
		in
		    Trie
