table fait_marche_agrege
	lineageTag: b595dcd7-000f-4011-a3a1-1b7057554fce

	/// Nombre de mutations (table agregee)
	measure 'Nb mutations agrege' = SUM(fait_marche_agrege[nombre_de_mutations])
		formatString: #,##0
		displayFolder: Datamart agrege
		lineageTag: cc6df45d-5d27-4e66-b581-9d07b34fd93f

	/// Nombre de locaux (table agregee)
	measure 'Nb locaux agrege' = SUM(fait_marche_agrege[nombre_de_locaux])
		formatString: #,##0
		displayFolder: Datamart agrege
		lineageTag: ca0c539f-74f9-4c5c-9b79-ed93aa050c34

	/// Valeur fonciere totale (table agregee)
	measure 'Valeur agregee' = SUM(fait_marche_agrege[valeur_fonciere_totale])
		formatString: #,##0 €
		displayFolder: Datamart agrege
		lineageTag: 49dbb92b-85f4-4ede-a5ad-2c2a128207f9

	/// Valeur fonciere moyenne par mutation (table agregee)
	measure 'Valeur moyenne agregee' = DIVIDE([Valeur agregee], [Nb mutations agrege])
		formatString: #,##0 €
		displayFolder: Datamart agrege
		lineageTag: ae310c0c-600c-4359-983f-912d69e47867

	/// Surface batie totale (table agregee)
	measure 'Surface agregee' = SUM(fait_marche_agrege[surface_batie_totale])
		formatString: #,##0.00
		displayFolder: Datamart agrege
		lineageTag: af65bb17-a1ed-47ff-bcbd-65701d39c6d7

	/// Prix moyen au m2 (table agregee)
	measure 'Prix moyen m2 agrege' = DIVIDE([Valeur agregee], [Surface agregee])
		formatString: #,##0.00 €
		displayFolder: Datamart agrege
		lineageTag: 6ed1fd4d-ef3f-4cc0-826f-0def555a67b3

